Vagrant.configure(2) do |config|
    config.vm.box = "bento/debian-13"
    config.vm.box_architecture = "arm64"
    config.vm.define "mbattyS" do |control|
            control.vm.hostname = "mbattyS"
            control.vm.network "private_network", ip: "192.168.56.110"
            control.vm.provider  "virtualbox" do |v|
                v.memory = 1024
                v.cpus = 1
                v.customize ["modifyvm", :id, "--name", "mbattyS"]
        end
        control.vm.provision "shell", path: "scripts/server.sh"
    end
    config.vm.define "mbattySW" do |control|
            control.vm.hostname = "mbattySW"
            control.vm.network "private_network", ip: "192.168.56.111"
            control.vm.provider  "virtualbox" do |v|
                v.memory = 1024
                v.cpus = 1
                v.customize ["modifyvm", :id, "--name", "mbattySW"]
            end
            control.vm.provision "shell", path: "scripts/server_worker.sh"
    end
end